{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/weather-api/weather-api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/weather-api/weather-api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/weather-api/weather-api.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "vite: dev",
            "type": "shell",
            "command": "npm run dev -- --host 0.0.0.0",
            "options": {
                "cwd": "${workspaceFolder}/weather-web"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "severity": "info",
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1,
                    "message": 1
                }
            }
        }
    ]
}