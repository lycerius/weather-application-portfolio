{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/weather-api/bin/Debug/net10.0/weather-api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/weather-api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Vite: React App",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev -- --host 0.0.0.0",
            "cwd": "${workspaceFolder}/weather-web",
            "serverReadyAction": {
                "pattern": "http://localhost:(\\d+)\\/?",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Open Vite in Host Browser",
            "type": "node-terminal",
            "request": "launch",
            "command": "python3 -c \"import os,sys; print('Open this in your host browser: http://localhost:5173')\" && echo 'Browser launch is handled by the host machine'",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}